# Copy to .env and fill in. Never commit the real .env.
# These are the only variables dbt needs (see profiles.yml).

DATABRICKS_HOST=https://dbc-f49d67a0-6a22.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/faced73bbff7e9f2
DATABRICKS_TOKEN=

# dev (default)
DBT_TARGET=dev
DBT_DEV_CATALOG=dbt
DBT_DEV_SCHEMA=dev

# prod
DBT_PROD_CATALOG=dbt_prod
DBT_PROD_SCHEMA=analytics

# optional: point the bronze layer at a different volume
DBT_RAW_VOLUME_PATH=/Volumes/dbt/raw/sales_analytics_raw
